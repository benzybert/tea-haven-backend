{"id":-1,"name":"Onboarding diagram","userId":-1,"createdAt":"","updatedAt":"","content":{"items":[{"uid":"KPEBqyKgRn","position":{"x":-490,"y":-170},"sizes":{"width":400,"height":889.5},"autoheight":true,"blockContent":{"type":"doc","content":[{"type":"filePathNode","attrs":{"pathToFile":"tea-haven-backend/","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"server.js"}]},{"type":"codeBlock","attrs":{"language":"javascript","wrapCode":true},"content":[{"type":"text","text":"const express = require('express');\nconst cors = require('cors');\nrequire('dotenv').config();\n\nconst app = express();\n\n// Middleware\napp.use(cors({\n  origin: 'http://localhost:3000',\n  credentials: true\n}));\napp.use(express.json());\n\n// Connect to MongoDB\nconst mongoose = require('mongoose');\nmongoose.connect(process.env.MONGODB_URI)\n  .then(() => {\n    console.log('MongoDB Connected');\n    console.log('Fetching all teas...');\n  })\n  .catch(err => console.log('MongoDB connection error:', err));\n\n// Routes\napp.use('/api/auth', require('./routes/auth'));\napp.use('/api/teas', require('./routes/teaRoutes'));\n\n// Error handling middleware\napp.use((err, req, res, next) => {\n  console.error(err.stack);\n  res.status(500).json({ message: 'Something went wrong!' });\n});\n\n// Explicitly use port 5001\nconst PORT = 5001;\n\napp.listen(PORT, () => {\n  console.log(`Server is running on port ${PORT}`);\n});"}]}]},"nodeType":"block"},{"uid":"Sp9lKzP5i8","position":{"x":20,"y":160},"sizes":{"width":400,"height":224.5},"autoheight":true,"blockContent":{"content":[{"type":"filePathNode","attrs":{"pathToFile":"tea-haven-backend/","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"server.js"}]},{"type":"codeBlock","attrs":{"language":"javascript","wrapCode":true},"content":[{"type":"text","text":"// Routes\napp.use('/api/auth', require('./routes/auth'));\napp.use('/api/teas', require('./routes/teaRoutes'));"}]}]},"nodeType":"block"},{"uid":"9r7p82Us_v","position":{"x":640,"y":-80},"sizes":{"width":400,"height":364.5},"autoheight":true,"blockContent":{"type":"doc","content":[{"type":"filePathNode","attrs":{"pathToFile":"tea-haven-backend/routes/","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"auth.js"}]},{"type":"codeBlock","attrs":{"language":"javascript","wrapCode":true},"content":[{"type":"text","text":"const express = require('express');\nconst router = express.Router();\nconst authController = require('../controllers/authController');\n\n// Register endpoint\nrouter.post('/register', authController.register);\n\n// Login endpoint\nrouter.post('/login', authController.login);\n\nmodule.exports = router;"}]}]},"nodeType":"block"},{"uid":"OwBGo3ush8","position":{"x":650,"y":350},"sizes":{"width":400,"height":434.5},"autoheight":true,"blockContent":{"content":[{"type":"filePathNode","attrs":{"pathToFile":"tea-haven-backend/routes/","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"teaRoutes.js"}]},{"type":"codeBlock","attrs":{"language":"javascript","wrapCode":true},"content":[{"type":"text","text":"const express = require('express');\nconst router = express.Router();\nconst teaController = require('../controllers/teaController');\n\n// Get all teas\nrouter.get('/search', teaController.getAllTeas);\n\n// Get tea by id\nrouter.get('/:id', teaController.getTeaById);\n\n// Get teas by type\nrouter.get('/type/:type', teaController.getTeasByType);\n\nmodule.exports = router;"}]}]},"nodeType":"block"},{"uid":"Gjp7E6HtD5","position":{"x":1200,"y":-400},"sizes":{"width":740,"height":434.5},"autoheight":true,"blockContent":{"type":"doc","content":[{"type":"filePathNode","attrs":{"pathToFile":"tea-haven-backend/controllers/","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"authController.js"}]},{"type":"codeBlock","attrs":{"language":"javascript","wrapCode":true},"content":[{"type":"text","text":"// Handle registration logic\nexports.register = async (req, res) => {\n    // 1. Get user data\n    // 2. Check if user exists\n    // 3. Hash password\n    // 4. Save user to database\n    // 5. Send response\n}\n\n// Handle login logic\nexports.login = async (req, res) => {\n    // 1. Get credentials\n    // 2. Verify user exists\n    // 3. Check password\n    // 4. Generate JWT token\n    // 5. Send response\n}"}]}]},"nodeType":"block"},{"uid":"HnkzlC5Ip_","position":{"x":1360,"y":130},"sizes":{"width":400,"height":854.5},"autoheight":true,"blockContent":{"type":"doc","content":[{"type":"filePathNode","attrs":{"pathToFile":"tea-haven-backend/controllers/","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"teaController.js"}]},{"type":"codeBlock","attrs":{"language":"javascript","wrapCode":true},"content":[{"type":"text","text":"const Produdct = require('../models/Product');\n\n// Handle tea retrieval logic\n    // 1. Get teas from database\n    // 2. Send response\nexports.getAllTeas = async (req, res, next) => {\n  try {\n    const teas = await Product.find({});\n    res.json({ products: teas });\n  } catch (error) {\n    next(error);\n  }\n};\n\nexports.getTeaById = async (req, res, next) => {\n  try {\n    const tea = await Product.findById(req.params.id);\n    if (!tea) {\n      return res.status(404).json({ message: 'Tea not found' });\n    }\n    res.json(tea);\n  } catch (error) {\n    next(error);\n  }\n};\n\nexports.getTeasByType = async (req, res, next) => {\n  try {\n    const teas = await Product.find({ category: req.params.type });\n    res.json({ products: teas });\n  } catch (error) {\n    next(error);\n  }\n};"}]}]},"nodeType":"block"},{"uid":"oil4FEH8JB","position":{"x":2320,"y":200},"sizes":{"width":400,"height":732},"autoheight":true,"blockContent":{"content":[{"type":"filePathNode","attrs":{"pathToFile":"tea-haven-backend/models/","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Order.js"}]},{"type":"codeBlock","attrs":{"language":"javascript","wrapCode":true},"content":[{"type":"text","text":"const mongoose = require('mongoose');\n\nconst OrderSchema = new mongoose.Schema({\n  user: { type: mongoose.Schema.Types.ObjectId, ref: 'User', required: true },\n  orderItems: [{\n    name: { type: String, required: true },\n    quantity: { type: Number, required: true },\n    price: { type: Number, required: true },\n    product: { type: mongoose.Schema.Types.ObjectId, ref: 'Product' }\n  }],\n  shippingAddress: {\n    address: { type: String, required: true },\n    city: { type: String, required: true },\n    postalCode: { type: String, required: true },\n    country: { type: String, required: true }\n  },\n  totalPrice: { type: Number, required: true },\n  isPaid: { type: Boolean, default: false },\n  paidAt: { type: Date },\n  isDelivered: { type: Boolean, default: false },\n  deliveredAt: { type: Date }\n}, { timestamps: true });\n\nmodule.exports = mongoose.model('Order', OrderSchema);"}]}]},"nodeType":"block"},{"uid":"oCWh-cZ9CW","position":{"x":2290,"y":-340},"sizes":{"width":400,"height":452},"autoheight":true,"blockContent":{"content":[{"type":"filePathNode","attrs":{"pathToFile":"tea-haven-backend/models/","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"Product.js"}]},{"type":"codeBlock","attrs":{"language":"javascript","wrapCode":true},"content":[{"type":"text","text":"const mongoose = require('mongoose');\n\n// Define tea product structure\n\n\nconst ProductSchema = new mongoose.Schema({\n  name: { type: String, required: true },\n  description: { type: String, required: true },\n  price: { type: Number, required: true },\n  category: { type: String, required: true },\n  image: { type: String, required: true },\n  countInStock: { type: Number, required: true }\n}, { timestamps: true });\n\nmodule.exports = mongoose.model('Product', ProductSchema);"}]}]},"nodeType":"block"},{"uid":"nKjmevOQT8","position":{"x":2290,"y":-860},"sizes":{"width":400,"height":382},"autoheight":true,"blockContent":{"content":[{"type":"filePathNode","attrs":{"pathToFile":"tea-haven-backend/models/","version":1},"content":[{"type":"text","marks":[{"type":"bold"}],"text":"User.js"}]},{"type":"codeBlock","attrs":{"language":"javascript","wrapCode":true},"content":[{"type":"text","text":"const mongoose = require('mongoose');\n\n// Define user data structure\n\nconst UserSchema = new mongoose.Schema({\n  name: { type: String, required: true },\n  email: { type: String, required: true, unique: true },\n  password: { type: String, required: true },\n  isAdmin: { type: Boolean, default: false }\n}, { timestamps: true });\n\nmodule.exports = mongoose.model('User', UserSchema);"}]}]},"nodeType":"block"},{"uid":"I-nSaceKZz","position":{"x":3073.9596603162818,"y":-272.10951765489574},"sizes":{"width":400,"height":84.5},"autoheight":true,"blockContent":{"type":"doc","content":[{"type":"paragraph","content":[{"type":"text","text":"mongoDB"}]}]},"nodeType":"block"},{"uid":"mZHzjkdzO9","position":{"x":-990,"y":230},"sizes":{"width":400,"height":84.5},"autoheight":true,"blockContent":{"type":"doc","content":[{"type":"paragraph","content":[{"type":"text","text":"Client Request"}]}]},"nodeType":"block"},{"uid":"86u2wqsZh7","position":{"x":640,"y":-260},"sizes":{"width":400,"height":84.5},"autoheight":true,"blockContent":{"type":"doc","content":[{"type":"paragraph","content":[{"type":"text","text":"Route layer"}]}]},"nodeType":"block"},{"uid":"zOXpliKObj","position":{"x":20,"y":0},"sizes":{"width":400,"height":84.5},"autoheight":true,"blockContent":{"type":"doc","content":[{"type":"paragraph","content":[{"type":"text","text":"Entry point"}]}]},"nodeType":"block"},{"uid":"t3ucnTDnL-","position":{"x":1300,"y":-550},"sizes":{"width":400,"height":84.5},"autoheight":true,"blockContent":{"type":"doc","content":[{"type":"paragraph","content":[{"type":"text","text":"Controllers"}]}]},"nodeType":"block"},{"uid":"IJSex8wn6J","position":{"x":2300,"y":-1060},"sizes":{"width":400,"height":84